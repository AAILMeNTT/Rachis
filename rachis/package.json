{
    "name": "rachis",
    "version": "0.6.0",
    "description": "Rachis Writing: Desktop App",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "t": "tauri",
        "t-d": "tauri dev",
        "t-bd": "tauri build --debug",
        "t-br": "tauri build --release",
        "sb": "storybook dev -p 6006",
        "sb-b": "storybook build"
    },
    "license": "MIT",
    "dependencies": {
        "@codemirror/language": "^6.12.3",
        "@lezer/highlight": "^1.2.3",
        "@lezer/lr": "^1.4.10",

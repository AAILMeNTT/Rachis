{
    "name": "rachis",
    "version": "0.6.0",
    "description": "Rachis Writing: Desktop App",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "t": "tauri",
        "t-d": "tauri dev",
        "t-bd": "tauri build --debug",
        "t-br": "tauri build --release",
        "sb": "storybook dev -p 6006",
        "sb-b": "storybook build"
    },
    "license": "MIT",
    "dependencies": {
        "@codemirror/language": "^6.12.4",
        "@lezer/highlight": "^1.2.3",
        "@lezer/lr": "^1.4.10",
        "@lucide/svelte": "^1.25.0",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-log": "^2.9.0",
        "@tauri-apps/plugin-opener": "^2.5.4"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.2.1",
        "@codemirror/commands": "^6.10.4",
        "@codemirror/lang-markdown": "^6.5.1",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.6",
        "@lezer/generator": "^1.8.0",
        "@storybook/addon-a11y": "^10.5.3",
        "@storybook/addon-docs": "^10.5.3",
        "@storybook/addon-svelte-csf": "^5.1.2",
        "@storybook/addon-vitest": "^10.5.3",
        "@storybook/sveltekit": "^10.5.3",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.1",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.11.4",
        "@types/node": "^26.1.1",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "codemirror": "^6.0.2",
        "playwright": "^1.61.1",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "storybook": "^10.5.3",
        "svelte": "^5.56.7",
        "svelte-check": "^4.7.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "prettier": {
        "plugins": [
            "prettier-plugin-tailwindcss",
            "prettier-plugin-svelte"
        ],
        "overrides": [
            {
                "files": "*.svelte",
                "options": {
                    "parser": "svelte"
                }
            }
        ],
        "bracketSameLine": true,
        "bracketSpacing": true,
        "endOfLine": "lf",
        "experimentalOperatorPosition": "start",
        "experimentalTernaries": true,
        "objectWrap": "preserve",
        "printWidth": 80,
        "quoteProps": "as-needed",
        "semi": true,
        "singleQuote": false,
        "tabWidth": 4,
        "trailingComma": "es5",
        "useTabs": false
    }
}

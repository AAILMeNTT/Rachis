{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": ["core:default", "opener:default"],
    "commands": {
        "allow": [
            "create_flight",
            "create_rachis",
            "delete_flight",
            "delete_rachis",
            "get_flight",
            "get_rachis_by_id",
            "get_rachises_by_title",
            "get_rachises_by_type",
            "parse_tag",
            "update_flight",
            "update_rachis"
        ]
    }
}
